<div class="w-full max-w-md mx-auto">
<form method="post" action="/api/login">
    <div class="bg-white p-6 rounded-lg shadow">
      
      <!-- Header -->
      <div class="mb-4 space-y-1">
        <h1 class="text-3xl font-bold text-pink-500">
          Sign In
        </h1>
        <p class="text-sm text-gray-500">
          Enter your details to sign in to your account
        </p>
      </div>

      <!-- Fields -->
      <div class="space-y-4">
        
        <!-- Email -->
        <div class="space-y-2">
          <label for="identifier" class="block text-sm font-medium">
            Email or Username
          </label>
          <input
            id="identifier"
            name="identifier"
            type="text"
            placeholder="username or email"
            class="w-full p-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-pink-500"
          />
        </div>

        <!-- Password -->
        <div class="space-y-2">
          <label for="password" class="block text-sm font-medium">
            Password
          </label>
          <input
            id="password"
            name="password"
            type="password"
            placeholder="password"
            class="w-full p-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-pink-500"
          />
        </div>
      </div>

      <!-- Button -->
      <div class="mt-6">
        <button
          type="submit"
          class="w-full bg-black text-white py-2 rounded-md hover:bg-gray-800 transition"
        >
          Sign In
        </button>
      </div>

    </div>

    <!-- Footer -->
    <div class="mt-4 text-center text-sm">
      Don't have an account?
      <a href="/auth/signup" class="ml-2 text-pink-500 hover:underline">
        Sign Up
      </a>
    </div>
  </form>
</div>
