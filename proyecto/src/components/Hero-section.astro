---
const { data, baseUrl } = Astro.props;

if (!data) return;

const {
  heading,
  subHeading,
  link,
  image
} = data;

const imageURL = image?.url?.startsWith('http')
  ? image.url
  : `${baseUrl}${image?.url}`;
---

<header class="relative h-150 overflow-hidden">
  <img
    src={imageURL}
    alt={image?.alternativeText ?? "Background"}
    width="1920"
    height="1080"
    class="absolute inset-0 w-full h-full object-cover"
  />

  <div class="relative z-10 flex flex-col items-center justify-center h-full text-center text-white bg-black/50">
    <h1 class="text-4xl font-bold md:text-5xl lg:text-6xl">
      {heading}
    </h1>

    <p class="mt-4 text-lg md:text-xl lg:text-2xl">
      {subHeading}
    </p>

    {link?.href && (
      <a
        href={link.href}
        target={link.isExternal ? "_blank" : "_self"}
        rel={link.isExternal ? "noopener noreferrer" : ""}
        class="mt-8 inline-flex items-center justify-center px-6 py-3 text-base font-medium text-black bg-white rounded-md shadow hover:bg-gray-100 transition-colors"
      >
        {link.label}
      </a>
    )}
  </div>
</header>
